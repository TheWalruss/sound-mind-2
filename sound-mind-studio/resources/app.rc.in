// Windows resource script: gives the built executable a real icon (shown
// by Explorer, the taskbar, and Alt+Tab) instead of the generic default
// one every prior build has run under - see docs/sound-mind-roadmap.md's
// Visual Identity milestone (v0.Y.14.1).
//
// IDI_ICON1 being the *first* ICON resource in the .rc is what makes
// Windows use it as the executable's own file icon; a second ICON
// statement wouldn't get that treatment, so this file deliberately only
// carries this one ICON resource (the VERSIONINFO block below is a
// different resource type).
IDI_ICON1 ICON "@CMAKE_CURRENT_SOURCE_DIR@/assets/ChooseAgainIcon.ico"

// The version and copyright Windows shows in the executable's Properties ->
// Details tab (v0.1.42.1). This file is a template: CMake's configure_file()
// fills in the version from the top-level project() and writes app.rc into
// the build directory.
#include <winver.h>

VS_VERSION_INFO VERSIONINFO
FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,@PROJECT_VERSION_TWEAK@
PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,@PROJECT_VERSION_TWEAK@
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS VS_FF_PRERELEASE
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "Andreas Lundberg"
            VALUE "FileDescription", "Sound Mind Studio"
            VALUE "FileVersion", "@PROJECT_VERSION@"
            VALUE "InternalName", "sound-mind-studio"
            VALUE "LegalCopyright", "Copyright (C) 2026 Andreas Lundberg. All rights reserved."
            VALUE "OriginalFilename", "sound-mind-studio.exe"
            VALUE "ProductName", "Sound Mind Studio"
            VALUE "ProductVersion", "@PROJECT_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
