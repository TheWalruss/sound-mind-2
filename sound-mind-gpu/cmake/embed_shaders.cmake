# Writes OUTPUT, a C++ source holding every compiled shader in SHADERS (a
# ;-list of .cso paths) as a byte array, plus the table
# sound_mind::gpu::detail::embeddedShaders() returns - so the shaders ship
# inside the program instead of as files next to the build (v0.1.41.6).
# Run as `cmake -DOUTPUT=... -DSHADERS=... -P embed_shaders.cmake`.

set(content "// Generated by sound-mind-gpu/cmake/embed_shaders.cmake - do not edit.\n")
string(APPEND content "#include \"embedded_shaders.h\"\n\nnamespace sound_mind::gpu::detail {\n\nnamespace {\n\n")
set(entries "")
foreach (path IN LISTS SHADERS)
    get_filename_component(name "${path}" NAME)
    string(MAKE_C_IDENTIFIER "${name}" id)
    file(READ "${path}" hex HEX)
    # Two hex digits per byte -> "0x..,", sixteen to a line.
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
    string(REGEX REPLACE "((0x[0-9a-f][0-9a-f],){16})" "\\1\n    " bytes "${bytes}")
    string(APPEND content "const unsigned char k_${id}[] = {\n    ${bytes}\n};\n\n")
    string(APPEND entries "        EmbeddedShader{\"${name}\", k_${id}, sizeof(k_${id})},\n")
endforeach ()
string(APPEND content "}  // namespace\n\n")
string(APPEND content "const std::vector<EmbeddedShader>& embeddedShaders() {\n")
string(APPEND content "    static const std::vector<EmbeddedShader> shaders{\n${entries}    };\n    return shaders;\n}\n\n")
string(APPEND content "}  // namespace sound_mind::gpu::detail\n")

# Only rewrite when something changed, so dependants don't rebuild needlessly.
if (EXISTS "${OUTPUT}")
    file(READ "${OUTPUT}" previous)
    if (previous STREQUAL content)
        return()
    endif ()
endif ()
file(WRITE "${OUTPUT}" "${content}")
